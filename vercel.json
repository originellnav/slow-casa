{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/property.html",
      "destination": "/houses",
      "permanent": true
    },
    {
      "source": "/property",
      "destination": "/houses",
      "permanent": true
    },
    {
      "source": "/directory",
      "destination": "/houses",
      "permanent": true
    },
    {
      "source": "/journal",
      "destination": "/magazine",
      "permanent": true
    },
    {
      "source": "/journal/:path*",
      "destination": "/magazine",
      "permanent": true
    },
    {
      "source": "/criteria",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/places",
      "destination": "/magazine",
      "permanent": true
    },
    {
      "source": "/guides",
      "destination": "/magazine",
      "permanent": true
    },
    {
      "source": "/house-tours",
      "destination": "/magazine/house-tours",
      "permanent": true
    },
    {
      "source": "/how-to",
      "destination": "/magazine/how-to",
      "permanent": true
    },
    {
      "source": "/places/:slug",
      "destination": "/",
      "statusCode": 410
    }
  ],
  "rewrites": [
    {
      "source": "/map",
      "destination": "/api/map"
    },
    {
      "source": "/mallorca",
      "destination": "/api/island?island=mallorca"
    },
    {
      "source": "/ibiza",
      "destination": "/api/island?island=ibiza"
    },
    {
      "source": "/menorca",
      "destination": "/api/island?island=menorca"
    },
    {
      "source": "/houses",
      "destination": "/api/directory"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/design-directory",
      "destination": "/api/architect?index=1"
    },
    {
      "source": "/architects/:slug",
      "destination": "/api/architect?slug=:slug"
    },
    {
      "source": "/mallorca/houses/:slug",
      "destination": "/api/property-page?slug=:slug&island=mallorca"
    },
    {
      "source": "/ibiza/houses/:slug",
      "destination": "/api/property-page?slug=:slug&island=ibiza"
    },
    {
      "source": "/menorca/houses/:slug",
      "destination": "/api/property-page?slug=:slug&island=menorca"
    },
    {
      "source": "/formentera/houses/:slug",
      "destination": "/api/property-page?slug=:slug&island=formentera"
    },
    {
      "source": "/:island(mallorca|ibiza|menorca|formentera)/places/:slug",
      "destination": "/api/place-page?island=:island&slug=:slug"
    },
    {
      "source": "/:island(mallorca|ibiza|menorca)/:section(where-to-stay|where-to-eat|what-to-do)",
      "destination": "/api/guides-index?section=:section&island=:island&hub=1"
    },
    {
      "source": "/mallorca/:slug",
      "destination": "/api/guide-page?slug=:slug&island=mallorca"
    },
    {
      "source": "/ibiza/:slug",
      "destination": "/api/guide-page?slug=:slug&island=ibiza"
    },
    {
      "source": "/menorca/:slug",
      "destination": "/api/guide-page?slug=:slug&island=menorca"
    },
    {
      "source": "/formentera/:slug",
      "destination": "/api/guide-page?slug=:slug&island=formentera"
    },
    {
      "source": "/properties/:slug",
      "destination": "/api/property-page?slug=:slug&legacy=1"
    },
    {
      "source": "/magazine",
      "destination": "/api/guides-index?section=magazine"
    },
    {
      "source": "/magazine/:section",
      "destination": "/api/guides-index?section=:section"
    },
    {
      "source": "/guides/:slug",
      "destination": "/api/guide-page?slug=:slug"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/go/:slug",
      "destination": "/api/go?slug=:slug"
    }
  ]
}
