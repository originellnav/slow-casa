{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/property.html",
      "destination": "/houses",
      "permanent": true
    },
    {
      "source": "/property",
      "destination": "/houses",
      "permanent": true
    },
    {
      "source": "/directory",
      "destination": "/houses",
      "permanent": true
    },
    {
      "source": "/journal",
      "destination": "/places",
      "permanent": true
    },
    {
      "source": "/journal/:path*",
      "destination": "/places",
      "permanent": true
    },
    {
      "source": "/criteria",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/places/:slug",
      "destination": "/",
      "statusCode": 410
    }
  ],
  "rewrites": [
    {
      "source": "/houses",
      "destination": "/api/directory"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/design-directory",
      "destination": "/api/architects-index"
    },
    {
      "source": "/architects/:slug",
      "destination": "/api/architect?slug=:slug"
    },
    {
      "source": "/mallorca/houses/:slug",
      "destination": "/api/property-page?slug=:slug"
    },
    {
      "source": "/ibiza/houses/:slug",
      "destination": "/api/property-page?slug=:slug"
    },
    {
      "source": "/menorca/houses/:slug",
      "destination": "/api/property-page?slug=:slug"
    },
    {
      "source": "/formentera/houses/:slug",
      "destination": "/api/property-page?slug=:slug"
    },
    {
      "source": "/mallorca/:slug",
      "destination": "/api/guide-page?slug=:slug&island=mallorca"
    },
    {
      "source": "/ibiza/:slug",
      "destination": "/api/guide-page?slug=:slug&island=ibiza"
    },
    {
      "source": "/menorca/:slug",
      "destination": "/api/guide-page?slug=:slug&island=menorca"
    },
    {
      "source": "/formentera/:slug",
      "destination": "/api/guide-page?slug=:slug&island=formentera"
    },
    {
      "source": "/properties/:slug",
      "destination": "/api/property-page?slug=:slug&legacy=1"
    },
    {
      "source": "/guides",
      "destination": "/api/guides-index?section=places"
    },
    {
      "source": "/places",
      "destination": "/api/guides-index?section=places"
    },
    {
      "source": "/house-tours",
      "destination": "/api/guides-index?section=house-tours"
    },
    {
      "source": "/how-to",
      "destination": "/api/guides-index?section=how-to"
    },
    {
      "source": "/guides/:slug",
      "destination": "/api/guide-page?slug=:slug"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/go/:slug",
      "destination": "/api/go?slug=:slug"
    }
  ]
}
